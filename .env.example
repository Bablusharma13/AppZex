# ==========================================================
# AppZex AgencyOS - Environment Configuration Template
# Copy to `.env` at the repository root (or backend/.env) and fill in values.
# NEVER commit real credentials.
# ==========================================================

# ---------- Runtime ----------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/appzex_agencyos
# Dedicated database used by the automated test suite
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/appzex_agencyos_test

# ---------- Authentication ----------
# MUST be replaced with a long, random secret in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ---------- CORS / Frontend ----------
# Comma separated list of allowed origins
CLIENT_URL=http://localhost:3000

# ---------- Super Admin bootstrap ----------
# Used only by the seed script to create the first SUPER_ADMIN account.
SUPER_ADMIN_EMAIL=admin@appzex-demo.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# ---------- AI (AI Meeting Summary workflow) ----------
# Any OpenAI-compatible provider. Leave blank to disable AI gracefully.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=45000

# ---------- File storage ----------
# Absolute or relative directory. Files are NEVER served statically.
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=15