# ==========================================================
# AppZex AgencyOS - Frontend configuration template
# Copy to `frontend/.env.local` and fill in values.
# NEVER commit real credentials.
# ==========================================================

# Base URL of the backend REST API (must include the /api prefix).
# Local development: http://localhost:5000/api
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public site origin, used for metadata and canonical URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000